# ClearSplit backend configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Database + collection used to persist per-user app state
MONGO_DB=clearsplit
MONGO_COLLECTION=app_states

# HTTP server
BACKEND_PORT=8081
BACKEND_HOST=0.0.0.0

# CORS: "*" for open demo access, or a specific frontend origin in production
CORS_ORIGIN=*
